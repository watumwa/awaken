{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "ecom/wsgi.py": {
      "excludeFiles": "{venv/**,.venv/**,static/**,staticfiles/**,media/media_files/**,media/media_thumbnails/**,media/product_images/**,db.sqlite3,stderr.log,**/*.log,**/__pycache__/**,**/*.pyc}"
    }
  },
  "rewrites": [
    {
      "source": "/media/:path*",
      "destination": "/static/media/:path*"
    }
  ]
}
