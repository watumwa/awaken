{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "ecom/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "framework": "django",
        "excludeFiles": "{venv/**,.venv/**,static/**,staticfiles/**,media/**,db.sqlite3,test.sqlite3,stderr.log,**/*.log,**/__pycache__/**,**/*.pyc,**/tests/**,**/test_*.py}"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/media/:path*",
      "destination": "/static/media/:path*"
    }
  ],
  "headers": [
    {
      "source": "/media/books/:path*",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    },
    {
      "source": "/static/media/books/:path*",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ]
}
