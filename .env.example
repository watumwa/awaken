# Required in every production environment. Generate a long, unique random value.
DJANGO_SECRET_KEY=
DEBUG=False

# Comma-separated public hostnames for the Django application.
ALLOWED_HOSTS=awakeningsaints.org,www.awakeningsaints.org
CSRF_TRUSTED_ORIGINS=https://awakeningsaints.org,https://www.awakeningsaints.org

# Configure exactly one database option.
# Vercel / PostgreSQL:
DATABASE_URL=
# Namecheap / MySQL:
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Email (required only when the app sends email).
EMAIL_HOST=awakeningsaints.org
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=info@awakeningsaints.org
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@awakeningsaints.org

# Payment gateway (required only when LivePay checkout is enabled).
LIVEPAY_PUBLIC_KEY=
LIVEPAY_SECRET_KEY=
LIVEPAY_ACCOUNT_NUMBER=
LIVEPAY_WEBHOOK_SECRET=
